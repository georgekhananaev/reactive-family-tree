---
/*
 * The demo: the tree filling the window, with a caption for the chosen person
 * and the year slider. It runs entirely in the browser.
 * Author: George Khananaev
 */

import { DemoTree } from '../components/DemoTree';
import Masthead from '../components/Masthead.astro';
import Site from '../layouts/Site.astro';
import { demoFamily } from '../lib/demo-family';
import { SITE_NAME } from '../lib/site.mjs';

// Counted from the family itself, so the page cannot say a number that is not true
const family = demoFamily();
const description = `The ${family.name}, ${family.tree.people.length} made-up people, on the live tree in your browser. Choose a leaf, drag and zoom, and replay the family growing year by year.`;
---

<Site title={`Demo: the ${family.name} | ${SITE_NAME}`} description={description}>
  <Masthead links={[{ href: '/', label: 'Home' }, { href: '/docs/', label: 'Docs' }]} />

  <main>
    <DemoTree explorer client:load />
  </main>
</Site>
