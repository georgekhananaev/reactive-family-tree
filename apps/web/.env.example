# Everything here is optional when you run the tree on your own computer.
# Only secrets and infrastructure are set here. The rest is set in the app, under "Manage family".

# Where people reach the tree, with no trailing slash. Sign-in for AI clients needs https, or localhost.
# PUBLIC_URL=https://family.example.com

# A file when self-hosted, or a Turso database when hosted without a disk.
# DATABASE_URL=file:./data/family.db
# DATABASE_AUTH_TOKEN=

# Signs sessions. When missing, one is made on first start and kept in the database.
# AUTH_SECRET=

# Plant the fictional Marlow family with a ready-made account for every role. Never for a real family.
# It keeps its data in a file of its own, data/demo/family.db, apart from a real family's.
# DEMO_MODE=1

# Claims a fresh install, for hosts where the server log cannot be read.
# SETUP_TOKEN=

# Sending email: SMTP or Resend. With neither, sign-in links are written to the server log.
# EMAIL_FROM=Family tree <tree@example.com>
# SMTP_URL=smtp://user:password@smtp.example.com:587
# RESEND_API_KEY=

# Optional Google sign-in, for people who already have an account on the tree.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Photos are kept in a "media" folder beside the database. To keep them in a bucket instead, set these four.
# Any S3-compatible store works. For Cloudflare R2 the endpoint is https://<account id>.r2.cloudflarestorage.com
# and the key pair comes from "Manage R2 API Tokens". S3_REGION is "auto" unless your store wants another.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# MEDIA_DIR=./data/media

# Daily jobs (compost, snapshot) run on a timer inside the server. On a host with no long-running
# process, turn the timer off and let the host's cron POST /api/jobs with this token.
# JOB_TIMERS=0
# JOBS_TOKEN=
