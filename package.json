{
  "name": "reactive-family-tree-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "A family tree that looks and behaves like a living plant. Self-hosted app, React package and MCP server.",
  "author": "George Khananaev",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @reactive-family-tree/web dev",
    "demo": "pnpm --filter @reactive-family-tree/web demo",
    "site": "pnpm --filter @reactive-family-tree/site dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @reactive-family-tree/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
